<?xml version="1.0"?>
<!DOCTYPE moduleset SYSTEM "moduleset.dtd">
<?xml-stylesheet type="text/xsl" href="moduleset.xsl"?>
<moduleset>

	<repository type="tarball" name="www.tortall.net" href="http://www.tortall.net"/>
	<repository type="tarball" name="www.nasm.us" href="http://www.nasm.us"/>

	<repository type="tarball" name="liboil" href="http://liboil.freedesktop.org/download/"/>
	<repository type="tarball" name="downloads.xiph.org" href="http://downloads.xiph.org/"/>
	<repository type="tarball" name="xpra.org" href="https://xpra.org"/>
	<repository type="tarball" name="downloads.webmproject.org" href="http://downloads.webmproject.org/"/>
	<repository type="tarball" name="ffmpeg.org" href="http://ffmpeg.org/"/>
	<repository type="tarball" name="download.gnome.org" default="yes" href="https://download.gnome.org/sources/"/>
	<repository type="tarball" name="github.com" default="yes" href="https://github.com/"/>
	<repository type="tarball" name="archive.mozilla.org" href="https://archive.mozilla.org/"/>
	<repository type="tarball" name="sourceforge" href="http://downloads.sourceforge.net/sourceforge/"/>
	<repository type="tarball" name="googleapis" href="https://storage.googleapis.com/"/>
	<repository type="tarball" name="downloads.videolan.org" href="https://downloads.videolan.org/pub/videolan/"/>

	<autotools id="nasm" autogenargs="" autogen-sh="configure">
		<branch module="/pub/nasm/releasebuilds/3.02/nasm-3.02.tar.xz"
			version="3.02"
			hash="sha256:87336eba53b4acfe917424ab5d500d2b0054d9f5148d35c2273ccf2cfb712f0d"
			repo="www.nasm.us">
		</branch>
	</autotools>


	<autotools id="liboil" autogen-template="autoreconf -fis &amp;&amp; %(srcdir)s/configure --prefix %(prefix)s  %(autogenargs)s"
		makeargs=' CFLAGS="$CFLAGS -DHAVE_SYMBOL_UNDERSCORE"'>
		<branch repo="liboil" module="liboil-0.3.17.tar.gz" version="0.3.17">
			<patch file="https://git.gnome.org/browse/gtk-osx/plain/patches/liboil-use-ac-config-headers-macro.patch" strip="1"/>
		</branch>
	</autotools>


	<autotools id="libogg" autogenargs="" autogen-sh="configure">
		<branch module="releases/ogg/libogg-1.3.6.tar.xz"
			version="1.3.6"
			hash="sha256:5c8253428e181840cd20d41f3ca16557a9cc04bad4a3d04cce84808677fa1061"
			repo="downloads.xiph.org">
		</branch>
	</autotools>

	<autotools id="libvorbis" autogenargs="" autogen-sh="autoreconf">
		<branch module="releases/vorbis/libvorbis-1.3.7.tar.xz"
			version="1.3.7"
			hash="sha256:b33cc4934322bcbf6efcbacf49e3ca01aadbea4114ec9589d1b1e9d20f72954b"
			repo="downloads.xiph.org">
			<patch file="libvorbis-drop-force_cpusubtype_ALL.patch"/>
		</branch>
		<dependencies>
			<dep package="libogg"/>
		</dependencies>
	</autotools>

	<autotools id="speex" autogen-sh="autoreconf">
		<branch module="xiph/speex/archive/refs/tags/Speex-1.2.1.tar.gz"
			version="1.2.1" checkoutdir="speex-Speex-1.2.1"
			hash="sha256:beaf2642e81a822eaade4d9ebf92e1678f301abfc74a29159c4e721ee70fdce0"
			repo="github.com"/>
	</autotools>

	<!--
	does not build on arm64, and not needed any more
	<autotools id="lame" autogenargs="" autogen-sh="configure">
		<branch module="lame/lame-3.100.tar.gz"
			version="3.100"
			hash="sha256:ddfe36cab873794038ae2c1210557ad34857a4b6bdc515785d1da9e175b1da1e"
			repo="sourceforge">
			<patch file="https://raw.githubusercontent.com/Xpra-org/gtk-osx-build/master/patches/lame-channels.patch" strip="1" />
			<patch file="https://raw.githubusercontent.com/Xpra-org/gtk-osx-build/master/patches/lame-remove-init-old.patch" strip="0" />
			<patch file="https://raw.githubusercontent.com/Xpra-org/gtk-osx-build/master/patches/0006-dont-use-outdated-symbol-list.patch" strip="1" />
		</branch>
		<dependencies>
			<dep package="nasm"/>
		</dependencies>
	</autotools>
	-->

	<autotools id="twolame" autogenargs="" autogen-sh="autogen.sh --disable-maintainer-mode" supports-non-srcdir-builds="no">
		<branch module="njh/twolame/archive/0.4.0.tar.gz"
			version="0.4.0" checkoutdir="twolame-0.4.0"
			hash="sha256:9f3f03bc9e1038d900f86002c7dce4b49109b3a61544800fc62d71dc51829f05"
			repo="github.com">
			<patch file="https://raw.githubusercontent.com/Xpra-org/gtk-osx-build/master/patches/twolame-nodoc.patch" strip="1"/>
		</branch>
	</autotools>

	<meson id="faac">
		<branch module="/knik0/faac/archive/refs/tags/faac-2.2.tar.gz"
			version="2.2" checkoutdir="faac-faac-2.2"
			hash="sha256:a93963573907c83e26e8cfabbf80d3a9c360f06ea4ecf1ea6cb74a202494d8d9"
			repo="github.com"/>
	</meson>

	<cmake id="faad2">
		<branch module="knik0/faad2/archive/refs/tags/2.11.4.tar.gz"
			version="2.11.4" checkoutdir="faad2-2.11.4"
			hash="sha256:ee479ccbae4a8387ab696e6f21a481bd83fe3881471cafa81b4ae59d7d3aed43"
			repo="github.com"/>
	</cmake>

	<autotools id="flac" autogen-sh="configure">
		<branch module="releases/flac/flac-1.5.0.tar.xz"
			version="1.5.0"
			hash="sha256:f2c1c76592a82ffff8413ba3c4a1299b6c7ab06c734dee03fd88630485c2b920"
			repo="downloads.xiph.org"/>
		<dependencies>
			<dep package="nasm"/>
			<dep package="libogg"/>
		</dependencies>
	</autotools>

	<autotools id="opus" autogen-sh="autoreconf" supports-non-srcdir-builds="no">
		<branch module="releases/opus/opus-1.6.1.tar.gz"
			version="1.6.1"
			hash="sha256:6ffcb593207be92584df15b32466ed64bbec99109f007c82205f0194572411a1"
			repo="downloads.xiph.org"/>
	</autotools>

	<autotools id="libvpx"
		autogen-template="%(srcdir)s/%(autogen-sh)s --prefix=%(prefix)s %(autogenargs)s"
		autogenargs="--enable-vp8 --enable-vp9 --enable-pic --enable-static --disable-install-docs --enable-realtime-only --enable-runtime-cpu-detect --disable-libyuv --disable-avx512 --disable-unit-tests"
		autogen-sh="configure">
		<branch module="webmproject/libvpx/archive/v1.17.0/libvpx-1.17.0.tar.gz"
			version="1.17.0" checkoutdir="libvpx-1.17.0"
			hash="sha256:1020f184046187baa2985dbde38e0691f49c44088bca7a1842b0236c6081dc0a"
			repo="github.com"/>
		<dependencies>
			<dep package="nasm"/>
		</dependencies>
	</autotools>

	<cmake id="libaom">
		<branch module="aom-releases/libaom-3.15.2.tar.gz"
			version="3.15.2"
			hash="sha256:67bb54b245f33ed98600e08269e6139986e48114e14042474ddd8885801dfddc"
			repo="googleapis">
			<patch file="https://raw.githubusercontent.com/Xpra-org/gtk-osx-build/master/patches/aom-nasm-multipass.patch" strip="1" />
		</branch>
	</cmake>

	<meson id="dav1d" mesonargs="-Denable_tools=false -Denable_tests=false">
		<branch module="dav1d/1.5.4/dav1d-1.5.4.tar.xz"
			version="1.5.4"
			hash="sha256:686616b7c69eb88d44459391ab25cac13b6647a3b288835c5784e71c1514a5c5"
			repo="downloads.videolan.org"/>
		<dependencies>
			<dep package="nasm"/>
		</dependencies>
	</meson>

	<autotools id="x264" autogen-template="%(srcdir)s/%(autogen-sh)s --prefix=%(prefix)s %(autogenargs)s" autogenargs="--enable-pic --enable-shared --enable-static" autogen-sh="configure">
		<branch module="https://code.videolan.org/videolan/x264/-/archive/b35605ace3ddf7c1a5d67a2eb553f034aef41d55/x264-b35605ace3ddf7c1a5d67a2eb553f034aef41d55.tar.bz2"
			checkoutdir="x264-b35605ace3ddf7c1a5d67a2eb553f034aef41d55"
			version="20250608-stable"
			hash="sha256:6eeb82934e69fd51e043bd8c5b0d152839638d1ce7aa4eea65a3fedcf83ff224"
			repo="github.com"/>
		<dependencies>
			<dep package="nasm"/>
		</dependencies>
		<after>
			<dep package="nasm"/>
		</after>
	</autotools>

	<meson id="openh264">
		<branch module="cisco/openh264/archive/refs/tags/v2.7.0.tar.gz" repo="github.com"
			checkoutdir="openh264-2.7.0" version="2.7.0"
		hash="sha256:5178775c8b440073e70920e97d195efff721c0e56d0a78cc82c919e95d54924d"/>
	</meson>

	<cmake id="libde265" cmakeargs="-DCMAKE_MACOSX_RPATH=ON -DCMAKE_INSTALL_NAME_DIR=@rpath -DENABLE_DECODER=OFF -DENABLE_ENCODER=OFF">
		<branch module="strukturag/libde265/archive/refs/tags/v1.1.3.tar.gz" repo="github.com"
			checkoutdir="libde265-1.1.3" version="1.1.3"
			hash="sha256:189baa08fd6d2dd34db099de411bd6b2e6bd5eb88e81236a3d0fa3826b9715c4"/>
	</cmake>

	<cmake id="libopenjph">
		<branch module="aous72/OpenJPH/archive/refs/tags/0.32.0.tar.gz" repo="github.com"
			checkoutdir="OpenJPH-0.32.0" version="0.32.0"
			hash="sha256:5cb1ebe18e5ee1322d23ff2130b37562d447d1ad5586c3d16cf84be3ae30f719"/>
	</cmake>

	<meson id="libspng">
		<branch module="randy408/libspng/archive/v0.7.4.tar.gz" repo="github.com"
			checkoutdir="libspng-0.7.4" version="0.7.4"
		hash="sha256:47ec02be6c0a6323044600a9221b049f63e1953faf816903e7383d4dc4234487"/>
	</meson>

	<autotools id="libwebp" autogenargs="" autogen-sh="configure" supports-non-srcdir-builds="no">
		 <branch module="releases/webp/libwebp-1.6.0.tar.gz"
			 version="1.6.0"
			 hash="sha256:e4ab7009bf0629fd11982d4c2aa83964cf244cffba7347ecd39019a9e38c4564"
			 repo="downloads.webmproject.org"/>
		 <dependencies>
			 <dep package="libjpeg"/>
			 <dep package="libpng"/>
		 </dependencies>
	</autotools>

	<autotools id="ffmpeg"
		autogen-template="%(srcdir)s/%(autogen-sh)s --prefix=%(prefix)s %(autogenargs)s"
		autogenargs="--enable-runtime-cpudetect --enable-pic
					--enable-static --enable-shared --enable-gpl
					--disable-everything
					--disable-debug
					--enable-swscale --enable-decoder=h264 --enable-decoder=mpeg4
					--enable-libvpx --enable-decoder=vp8 --enable-decoder=vp9 --enable-decoder=hevc
					--enable-encoder=libvpx_vp8 --enable-encoder=libvpx_vp9 --enable-encoder=mpeg4
					--enable-muxer=mp4 --enable-muxer=webm --enable-muxer=matroska --enable-muxer=ogg
					--disable-protocol=tcp --disable-protocol=rtp
					--disable-filter=aformat --disable-filter=crop --disable-filter=setpts
					--disable-filter=anull --disable-filter=trim --disable-filter=atrim
					--enable-filter=format --enable-filter=null --enable-filter=copy
					--disable-programs --disable-doc"
		autogen-sh="configure">
        <branch module="releases/ffmpeg-9.0.2.tar.xz"
            version="9.0.2"
            hash="sha256:8c3850283eb25fa026482078a04051e0be17347b09ef81a0849bec15a96e002e"
			repo="ffmpeg.org"/>
		<dependencies>
			<dep package="x264"/>
			<dep package="libvpx"/>
		</dependencies>
		<after>
			<dep package="x264"/>
			<dep package="libvpx"/>
		</after>
	</autotools>

	<cmake id="libyuv" cmakeargs="-DCMAKE_MACOSX_RPATH=ON -DCMAKE_INSTALL_NAME_DIR=@rpath -DCMAKE_POLICY_VERSION_MINIMUM=3.5">
		<!-- Match Xpra's RPM spec: upstream commit 5d03bf9bab5693ccf692f18b538d8d9c00387c73. -->
		<branch module="https://snapshot.debian.org/archive/debian/20260707T202226Z/pool/main/liby/libyuv/libyuv_0.0.1949.20260706.orig.tar.xz"
			version="0.0.1949.20260706" checkoutdir="libyuv-0.0.1949.20260706"
			hash="sha256:28c3cd7d109c93202ce3e7fd5a5534db7c137929b06c6792d6a904fe2ac130d1"
			repo="xpra.org">
			<patch file="https://raw.githubusercontent.com/Xpra-org/gtk-osx-build/master/patches/libyuv-nojpeg.patch" strip="1" />
			<patch file="https://raw.githubusercontent.com/Xpra-org/gtk-osx-build/master/patches/libyuv-add-pkgconfig.patch" strip="1" />
		</branch>
	</cmake>

	<cmake id="libavif" cmakeargs="-DAVIF_CODEC_AOM=SYSTEM">
		<branch module="AOMediaCodec/libavif/archive/refs/tags/v1.4.2.tar.gz"
			version="1.4.2" checkoutdir="libavif-1.4.2"
			hash="sha256:2b645287340ba5a631d268b551dc2d72bd73ac33335962dd36dcdb6d8366921d"
			repo="github.com">
		</branch>
		<dependencies>
			<dep package="libaom"/>
		</dependencies>
		<after>
			<dep package="libaom"/>
		</after>
	</cmake>

	<autotools id="libqrencode" autogen-sh="autoreconf" supports-non-srcdir-builds="no">
		<branch module="fukuchi/libqrencode/archive/v4.1.1.tar.gz"
			version="4.1.1" checkoutdir="libqrencode-4.1.1"
			hash="sha256:5385bc1b8c2f20f3b91d258bf8ccc8cf62023935df2d2676b5b67049f31a049c"
			repo="github.com">
		</branch>
	</autotools>

	<metamodule id="meta-osx-xpra-codec-deps">
		<dependencies>
			<dep package="nasm"/>
			<dep package="liborc"/>
			<dep package="libogg"/>
			<dep package="libvorbis"/>
			<dep package="speex"/>
			<dep package="twolame"/>
			<dep package="faac"/>
			<dep package="faad2"/>
			<dep package="flac"/>
			<dep package="opus"/>
			<dep package="libyuv"/>
			<dep package="libvpx"/>
			<dep package="libaom"/>
			<dep package="dav1d"/>
			<dep package="libavif"/>
			<dep package="x264"/>
			<dep package="libwebp"/>
			<dep package="openh264"/>
			<dep package="libde265"/>
			<dep package="libopenjph"/>
			<dep package="libspng"/>

			<dep package="ffmpeg"/>
			<dep package="libqrencode"/>
			<dep package="lz4"/>
		</dependencies>
	</metamodule>

</moduleset>
