<?xml version="1.0"?>
<!DOCTYPE moduleset SYSTEM "moduleset.dtd">
<?xml-stylesheet type="text/xsl" href="moduleset.xsl"?>
<moduleset>
  <!-- Please format this file using the following command:
       tidy -config ../tidy.conf -m gtk-osx-network.modules; sed -i "" '/^ *$/d' gtk-osx-network.modules
       You can get 'tidy' here: https://github.com/htacg/tidy-html5 -->
  <repository name="download.gnome.org"
              default="yes"
              href="https://download.gnome.org/sources/"
              type="tarball" />
  <repository name="ftp.gnu.org"
              href="https://ftp.gnu.org/gnu/"
              type="tarball" />
  <repository name="gnupg.org"
              href="https://gnupg.org/ftp/"
              type="tarball" />
  <repository name="webm"
              href="http://downloads.webmproject.org/releases/"
              type="tarball" />
  <repository name="webkit.org"
              href="https://webkitgtk.org/releases/"
              type="tarball" />
  <repository name="github-tarball"
              href="https://github.com/"
              type="tarball" />
  <repository name="zlib"
              href="https://www.zlib.net/"
              type="tarball" />
  <!-- Builds latest stable version of WebKitGTK for GTK 3.x -->
  <metamodule id="meta-gtk-osx-webkit-gtk3">
    <dependencies>
      <dep package="meta-gtk-osx-gtk3" />
      <dep package="webkit2gtk3" />
    </dependencies>
  </metamodule>
  <!-- of the many arguments such as prefix and libdir that jhbuild might pass
       to configure, openssl only understands prefix, and only with =. -->
  <!-- Keep OpenSSL on 3.5.x for now; allow updates within that branch.
       Branch hold recorded 2026-10-15; see README.md. -->
  <autotools id="openssl"
             autogen-sh="Configure"
             autogen-template="%(srcdir)s/%(autogen-sh)s --prefix=%(prefix)s %(autogenargs)s"
             autogenargs="shared"
             makeinstallargs="install_sw">
    <branch module="openssl/openssl/releases/download/openssl-3.5.9/openssl-3.5.9.tar.gz"
            version="3.5.9"
            hash="sha256:603f5602e2eef00d77fbd429d34dcd5822bb301757a1bc9cdb24c670f1eb859a"
            repo="github-tarball" />
  </autotools>
  <if condition-set="arm64">
    <autotools id="libnettle"
               autogen-sh="configure"
               autogenargs="--disable-documentation --disable-assembler">
      <branch module="nettle/nettle-4.0.tar.gz"
              version="4.0"
              hash="sha256:3addbc00da01846b232fb3bc453538ea5468da43033f21bb345cb1e9073f5094"
              repo="ftp.gnu.org" />
      <dependencies>
        <dep package="gmp" />
        <dep package="openssl" />
      </dependencies>
    </autotools>
  </if>
  <if condition-unset="arm64">
    <autotools id="libnettle"
               autogen-sh="configure"
               autogenargs="--disable-documentation">
      <branch module="nettle/nettle-4.0.tar.gz"
              version="4.0"
              hash="sha256:3addbc00da01846b232fb3bc453538ea5468da43033f21bb345cb1e9073f5094"
              repo="ftp.gnu.org" />
      <dependencies>
        <dep package="gmp" />
        <dep package="openssl" />
      </dependencies>
    </autotools>
  </if>
  <autotools id="libtasn1"
             autogen-sh="configure">
    <branch module="libtasn1/libtasn1-4.21.0.tar.gz"
            version="4.21.0"
            hash="sha256:1d8a444a223cc5464240777346e125de51d8e6abf0b8bac742ac84609167dc87"
            repo="ftp.gnu.org" />
  </autotools>
  <cmake id="zlib"
         cmakeargs='-DCMAKE_INSTALL_NAME_DIR="${JHBUILD_PREFIX}/lib"'>
    <branch module="zlib-1.3.2.tar.gz"
            version="1.3.2"
            hash="sha256:bb329a0a2cd0274d05519d61c667c062e06990d72e125ee2dfa8de64f0119d16"
            repo="zlib" />
  </cmake>
  <autotools id="p11-kit"
             autogen-sh="configure"
             autogenargs="--without-trust-paths">
    <branch module="p11-glue/p11-kit/releases/download/0.26.5/p11-kit-0.26.5.tar.xz"
            version="0.26.5"
            hash="sha256:f2cc09111e44bf3fea58f023180b33acea90aa82d042d6fbb623fbc5ba033bb7"
            repo="github-tarball">
      <patch file="p11-kit-libintl.patch"
             strip="1" />
    </branch>
    <dependencies>
      <dep package="libtasn1" />
    </dependencies>
  </autotools>
  <autotools id="gnutls"
             autogen-sh="autoreconf"
             autogenargs="--disable-doc --with-included-unistring">
    <branch module="gcrypt/gnutls/v3.8/gnutls-3.8.13.tar.xz"
            version="3.8.13"
            hash="sha256:ffed8ec1bf09c2426d4f14aae377de4753b53e537d685e604e99a8b16ca9c97e"
            repo="gnupg.org">
    </branch>
    <dependencies>
      <dep package="libnettle" />
      <dep package="libtasn1" />
      <dep package="libgcrypt" />
      <dep package="meta-gtk-osx-bootstrap"/>
      <dep package="p11-kit" />
      <dep package="zlib" />
    </dependencies>
  </autotools>
  <autotools id="libgpg-error"
             autogen-sh="autoreconf"
             autogenargs="--disable-doc">
    <branch module="gcrypt/libgpg-error/libgpg-error-1.61.tar.bz2"
            version="1.61"
            hash="sha256:7a85413f2bc354f4f8aa832b718af122e48965e9e0eb9012ee659c13c6385c93"
            repo="gnupg.org" />
  </autotools>
  <autotools id="libgcrypt"
             autogen-sh="configure"
             autogenargs="gcry_cv_gcc_asm_cfi_directives=no">
    <branch module="gcrypt/libgcrypt/libgcrypt-1.12.4.tar.bz2"
            version="1.12.4"
            hash="sha256:d77f68f48879510e79a2f65977ccc68981781ea0923e5bdffac2a193ea3d660e"
            repo="gnupg.org" />
    <dependencies>
      <dep package="libgpg-error" />
    </dependencies>
  </autotools>
  <meson id="libsecret"
         mesonargs="-Dvapi=disabled -Dgtk_doc=disabled">
    <branch module="libsecret/0.21/libsecret-0.21.8.2.tar.xz"
            version="0.21.8.2"
            hash="sha256:142948339c5b971d8f6a8c7099521f6fd319b6fe73d2694b4e6d3310ed28b6e6" />
    <dependencies>
      <dep package="glib" />
      <dep package="libgcrypt" />
    </dependencies>
  </meson>
  <meson id="gcr">
    <branch module="gcr/4.4/gcr-4.4.1.tar.xz"
            version="4.4.1"
            hash="sha256:c4442c15d4330f17a1f5194df08c576877af68412ab2521446a93bd5e24c931b" />
    <dependencies>
      <dep package="p11-kit" />
      <dep package="gpg" />
      <dep package="libsecret" />
      <dep package="glib" />
    </dependencies>
  </meson>
  <!-- GNOME Keyring still requires the GCK 1 / GCR 3 APIs. -->
  <meson id="gcr3"
         mesonargs="-Dgtk=false -Dgtk_doc=false -Dintrospection=false -Dssh_agent=false -Dsystemd=disabled">
    <branch module="gcr/3.41/gcr-3.41.2.tar.xz" version="3.41.2"
            hash="sha256:bad10f3c553a0e1854649ab59c5b2434da22ca1a54ae6138f1f53961567e1ab7" />
    <dependencies>
      <dep package="p11-kit" />
      <dep package="libgcrypt" />
      <dep package="glib" />
    </dependencies>
  </meson>
  <meson id="gnome-keyring" mesonargs="-Dpam=false -Dsystemd=disabled">
    <branch module="gnome-keyring/51/gnome-keyring-51.1.tar.xz"
            version="51.1"
            hash="sha256:dfe7adc5876ef0670e7eba2907799bdbb8875ce58bb4208e1a52169bd16a47ca" />
    <dependencies>
      <dep package="libgcrypt" />
      <dep package="gcr3" />
      <dep package="libxslt" />
    </dependencies>
  </meson>
  <meson id="gsettings-desktop-schemas">
    <branch module="gsettings-desktop-schemas/51/gsettings-desktop-schemas-51.0.tar.xz"
            version="51.0"
            hash="sha256:1e2419a5f21d26c324b28ae1c00e29e9175e8b596fff385a04c2172b36652226" />
  </meson>
  <meson id="libproxy"
         mesonargs="-Ddocs=false -Dtests=false -Dpacrunner-duktape=false -Dvapi=false -Dcurl=false -Dintrospection=false">
    <branch module="libproxy/libproxy/archive/refs/tags/0.5.12.tar.gz"
            version="0.5.12"
            hash="sha256:a1fa55991998b80a567450a9e84382421a7176a84446c95caaa8b72cf09fa86f"
            checkoutdir="libproxy-0.5.12"
            repo="github-tarball" />
    <dependencies>
      <dep package="gsettings-desktop-schemas" />
    </dependencies>
  </meson>
  <meson id="glib-networking"
         mesonargs="-Dopenssl=enabled">
    <branch module="glib-networking/2.90/glib-networking-2.90.0.tar.xz"
            version="2.90.0"
            hash="sha256:83a75e3d9c36b66ee86d3281c2fc997816101968a5126ba322b2acb9a74dd8c0" />
    <dependencies>
      <dep package="libproxy" />
      <dep package="gnutls" />
      <dep package="glib" />
    </dependencies>
  </meson>
  <!-- Use JHBuild's ICU headers and libraries together instead of mixing the
       versioned headers with Apple's unversioned libicucore symbols. -->
  <autotools id="libpsl"
             autogen-sh="configure"
             autogenargs="--enable-runtime=libicu">
    <branch module="rockdaboot/libpsl/releases/download/0.23.3/libpsl-0.23.3.tar.gz"
            version="0.23.3"
            hash="sha256:93941f85a1e7bd593fa94f299233cb5dfc91cd144fd9a78a6ceb75001c5b03be"
            repo="github-tarball" />
    <dependencies>
      <dep package="icu" />
    </dependencies>
  </autotools>
  <meson id="libsoup"
         mesonargs="-Dvapi=disabled">
    <branch module="libsoup/2.74/libsoup-2.74.3.tar.xz"
            version="2.74.3"
            hash="sha256:e4b77c41cfc4c8c5a035fcdc320c7bc6cfb75ef7c5a034153df1413fa1d92f13">
    </branch>
    <dependencies>
      <dep package="libpsl" />
      <dep package="python3" />
      <dep package="glib" />
      <dep package="glib-networking" />
      <dep package="sqlite" />
    </dependencies>
  </meson>
  <cmake id="libnghttp2"
         cmakeargs='-DENABLE_LIB_ONLY=ON -DENABLE_DOC=OFF -DWITH_LIBXML2=OFF -DWITH_JEMALLOC=OFF -DWITH_MRUBY=OFF -DWITH_NEVERBLEED=OFF -DWITH_LIBBPF=OFF -DCMAKE_INSTALL_NAME_DIR="${JHBUILD_PREFIX}/lib"'>
    <branch module="nghttp2/nghttp2/releases/download/v1.70.0/nghttp2-1.70.0.tar.xz"
            version="1.70.0"
            hash="sha256:e05cb1388eaca3830aded4ccf20044b6e1ac1a61411dcca11b0437c4285c8bc2"
            repo="github-tarball" />
    <dependencies>
      <dep package="openssl" />
      <dep package="zlib" />
    </dependencies>
  </cmake>
  <meson id="libsoup3"
         mesonargs="-Dvapi=disabled">
    <branch module="libsoup/3.8/libsoup-3.8.0.tar.xz"
            version="3.8.0"
            hash="sha256:bbf08fa3e03a88c31a3d27a0d87cb422e9490f2d08e149211103df6d638a2238" />
    <dependencies>
      <dep package="libpsl" />
      <dep package="python3" />
      <dep package="glib" />
      <dep package="glib-networking" />
      <dep package="libnghttp2" />
      <dep package="sqlite" />
    </dependencies>
  </meson>
  <autotools id="libwebp"
             autogen-sh="configure"
             autogenargs="--enable-libwebpmux --enable-libwebpdecoder">
    <branch module="webp/libwebp-1.6.0.tar.gz"
            version="1.6.0"
            hash="sha256:e4ab7009bf0629fd11982d4c2aa83964cf244cffba7347ecd39019a9e38c4564"
            repo="webm" />
  </autotools>
  <!-- Build the GTK3/Quartz API (4.1, using libsoup 3). Disable Linux display
       and tracing backends, media/GL features, and optional dependencies not
       supplied by this moduleset. Keep the macOS bundle integration patch.
       MiniBrowser provides a manual smoke test: jhbuild run MiniBrowser. -->
  <cmake id="webkit2gtk3"
         cmakeargs='-DPORT=GTK -DUSE_GTK4=OFF -DENABLE_X11_TARGET=OFF -DENABLE_WAYLAND_TARGET=OFF -DENABLE_QUARTZ_TARGET=ON -DENABLE_MINIBROWSER=ON -DENABLE_INTROSPECTION=ON -DENABLE_DOCUMENTATION=OFF -DENABLE_JOURNALD_LOG=OFF -DUSE_LIBDRM=OFF -DUSE_GBM=OFF -DUSE_LIBBACKTRACE=OFF -DUSE_SYSPROF_CAPTURE=OFF -DUSE_GSTREAMER=OFF -DENABLE_VIDEO=OFF -DENABLE_WEB_AUDIO=OFF -DENABLE_WEBGL=OFF -DENABLE_SPEECH_SYNTHESIS=OFF -DUSE_LIBHYPHEN=OFF -DUSE_LIBSECRET=OFF -DENABLE_TOUCH_EVENTS=OFF -DUSE_WOFF2=OFF -DUSE_AVIF=OFF -DUSE_JPEGXL=OFF -DUSE_LCMS=OFF -DENABLE_GAMEPAD=OFF -DCMAKE_CXX_FLAGS="-stdlib=libc++  -Wno-deprecated-declarations -Wno-unused-but-set-variable -Wno-deprecated-copy -Wno-missing-template-arg-list-after-template-kw" -DCMAKE_MACOSX_RPATH=OFF -DCMAKE_INSTALL_NAME_DIR="${JHBUILD_PREFIX}/lib"'>
    <branch module="webkitgtk-2.54.1.tar.xz"
            version="2.54.1"
            hash="sha256:ea0bbb02dbdbc596874a4e7ad35b66645b3e0a232bd0e4081de5ed92eb0a397d"
            repo="webkit.org">
      <patch file="webkitgtk-2.54.1-quartz.patch" strip="1" />
    </branch>
    <dependencies>
      <dep package="libwebp" />
      <dep package="enchant" />
      <dep package="icu" />
      <dep package="libsoup3" />
      <dep package="libgcrypt" />
      <dep package="libtasn1" />
      <dep package="libepoxy" />
      <dep package="libxml2" />
      <dep package="libxslt" />
      <dep package="expat" />
      <dep package="sqlite" />
      <dep package="harfbuzz" />
      <dep package="fontconfig" />
      <dep package="meta-gtk-osx-gtk3" />
    </dependencies>
    <after>
      <dep package="meta-gtk-osx-gstreamer" />
    </after>
  </cmake>
</moduleset>
