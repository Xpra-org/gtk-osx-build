<?xml version="1.0"?>
<!DOCTYPE moduleset SYSTEM "moduleset.dtd">
<?xml-stylesheet type="text/xsl" href="moduleset.xsl"?>
<moduleset>
  <!-- Please format this file using the following command:
       tidy -config ../tidy.conf -m gtk-osx-gstreamer.modules; sed -i "" '/^ *$/d' gtk-osx-gstreamer.modules
       You can get 'tidy' here: https://github.com/htacg/tidy-html5 -->
  <repository name="gstreamer"
              default="yes"
              href="http://gstreamer.freedesktop.org/src/"
              type="tarball" />
  <repository name="github.com"
              href="https://github.com/"
              type="tarball" />
  <repository name="ffmpeg"
              href="https://ffmpeg.org/releases/"
              type="tarball" />
  <repository name="pypi"
              href="https://files.pythonhosted.org/packages/source/"
              type="tarball" />

  <!-- Shared definitions for the bundled codec and support libraries below. -->
  <include href="../xpra-codecs.modules" />
  <include href="../xpra-tools.modules" />

  <meson id="liborc"
         mesonargs="-Dbenchmarks=disabled -Dexamples=disabled -Dtests=disabled">
    <branch module="orc/orc-0.4.44.tar.xz"
            version="0.4.44"
            hash="sha256:4aeb97aea2b58224029dc2b23d7d064cfa990cb4fb8c4da440bcbe9c95bc5d2d" />
  </meson>
  <cmake id="faad2">
    <branch module="knik0/faad2/archive/refs/tags/2.11.4.tar.gz"
            version="2.11.4"
            checkoutdir="faad-2.11.4"
            hash="sha256:ee479ccbae4a8387ab696e6f21a481bd83fe3881471cafa81b4ae59d7d3aed43"
            repo="github.com" />
  </cmake>
  <autotools id="ffmpeg"
             autogen-sh="configure"
             autogen-template="%(srcdir)s/%(autogen-sh)s --prefix=%(prefix)s %(autogenargs)s"
             autogenargs="--enable-gpl --enable-version3 --enable-shared --disable-static --disable-runtime-cpudetect --disable-programs --disable-ffplay --disable-ffprobe --disable-doc">
    <branch module="ffmpeg-9.0.2.tar.xz"
            version="9.0.2"
            hash="sha256:8c3850283eb25fa026482078a04051e0be17347b09ef81a0849bec15a96e002e"
            repo="ffmpeg" />
    <dependencies>
      <dep package="nasm" />
    </dependencies>
  </autotools>
  <meson id="gstreamer">
    <branch module="gstreamer/gstreamer-1.28.9.tar.xz"
            version="1.28.9"
            hash="sha256:6dbf744f583131a34845cc641e803843766a9ba80ce00378a9043fd6d8d5fb38">
    </branch>
    <after>
      <dep package="glib" />
    </after>
  </meson>
  <meson id="gst-plugins-base"
         mesonargs="-Dexamples=disabled -Ddoc=disabled">
    <branch module="gst-plugins-base/gst-plugins-base-1.28.9.tar.xz"
            version="1.28.9"
            hash="sha256:c1fda668b520e6aef763c0eb962c032c9fe52bce322e8b00c69b4e9e847bddc1" />
    <dependencies>
      <dep package="gstreamer" />
      <dep package="liborc" />
      <dep package="libogg" />
      <dep package="libvorbis" />
      <dep package="opus" />
      <dep package="pango" />
      <dep package="graphene" />
      <dep package="libpng" />
      <dep package="libjpeg" />
      <dep package="zlib" />
    </dependencies>
  </meson>
  <meson id="gst-plugins-good">
    <branch module="gst-plugins-good/gst-plugins-good-1.28.9.tar.xz"
            version="1.28.9"
            hash="sha256:e518cd97483706a252e95e60312a22d23dec6f5e7673af6f5bde719c3a9ca7f4">
    </branch>
    <dependencies>
      <dep package="gstreamer" />
      <dep package="gst-plugins-base" />
      <dep package="libxml2" />
      <dep package="flac" />
      <dep package="speex" />
      <dep package="twolame" />
      <dep package="libvpx" />
      <dep package="libpng" />
      <dep package="libjpeg" />
      <dep package="cairo" />
      <dep package="gdk-pixbuf" />
      <dep package="gtk+-3.0" />
      <dep package="zlib" />
      <dep package="libsoup" />
      <dep package="libsoup3" />
      <dep package="libnettle" />
      <dep package="libgcrypt" />
      <dep package="openssl" />
    </dependencies>
  </meson>
  <meson id="gst-plugins-ugly"
         mesonargs="-Dgpl=enabled -Dx264=enabled">
    <branch module="gst-plugins-ugly/gst-plugins-ugly-1.28.9.tar.xz"
            version="1.28.9"
            hash="sha256:550a52536962186f5488e06b5c08f31ae0f18400aee32a3385156d31cb4b1189" />
    <dependencies>
      <dep package="gstreamer" />
      <dep package="gst-plugins-base" />
      <dep package="x264" />
    </dependencies>
  </meson>
  <meson id="gst-plugins-bad">
    <branch module="gst-plugins-bad/gst-plugins-bad-1.28.9.tar.xz"
            version="1.28.9"
            hash="sha256:4a4e0b7bf84f868378c48f143a7ac3a98923b488a5b74f1a35ba46bc3c43f6b1">
      <patch file="gst-plugins-bad-missing-enum.patch"
             strip="1" />
    </branch>
    <dependencies>
      <dep package="gstreamer" />
      <dep package="gst-plugins-base" />
      <dep package="faad2" />
      <dep package="openssl" />
      <dep package="libxml2" />
      <dep package="faac" />
      <dep package="libaom" />
      <dep package="libde265" />
      <dep package="openh264" />
      <dep package="opus" />
      <dep package="libwebp" />
      <dep package="librsvg" />
      <dep package="libqrencode" />
      <dep package="cairo" />
      <dep package="pango" />
      <dep package="curl" />
      <dep package="libnettle" />
      <dep package="libgcrypt" />
    </dependencies>
  </meson>
  <meson id="gst-libav">
    <branch module="gst-libav/gst-libav-1.28.9.tar.xz"
            version="1.28.9"
            hash="sha256:4b3df21fa70972a80891d2298cf32c14a62c3db4483d545c7ac018230399186b">
    </branch>
    <dependencies>
      <dep package="gstreamer" />
      <dep package="gst-plugins-base" />
      <dep package="ffmpeg" />
    </dependencies>
  </meson>

  <pip id="python3-typing-extensions" python3="1">
    <branch module="t/typing_extensions/typing_extensions-4.16.0.tar.gz"
            hash="sha256:dc983d19a509c94dba722ee6abd33940f7c05a89e243c47e907eb4db6f1a43e5"
            version="4.16.0"
            repo="pypi" />
    <dependencies>
      <dep package="python3" />
    </dependencies>
    <after>
      <dep package="python3" />
    </after>
  </pip>

  <meson id="gst-python">
    <branch module="gst-python/gst-python-1.28.9.tar.xz"
            version="1.28.9"
            hash="sha256:e6ad2658fad5b96d99af72ceec7e48995ff792fbda438d34486d189ce047718a">
    </branch>
    <dependencies>
      <dep package="gstreamer" />
      <dep package="gst-plugins-base" />
      <dep package="pygobject3" />
      <dep package="python3-typing-extensions" />
    </dependencies>
  </meson>
  <metamodule id="meta-gtk-osx-gstreamer">
    <dependencies>
      <dep package="gstreamer" />
      <dep package="gst-plugins-base" />
      <dep package="gst-plugins-good" />
      <dep package="gst-plugins-ugly" />
      <dep package="gst-plugins-bad" />
      <dep package="gst-libav" />
      <dep package="gst-python" />
    </dependencies>
  </metamodule>
</moduleset>
