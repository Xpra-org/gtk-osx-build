<?xml version="1.0"?>
<!DOCTYPE moduleset SYSTEM "moduleset.dtd">
<?xml-stylesheet type="text/xsl" href="moduleset.xsl"?>
<moduleset>
  <!-- Please format this file using the following command:
       tidy -config ../tidy.conf -m gtk-osx-gstreamer.modules; sed -i "" '/^ *$/d' gtk-osx-gstreamer.modules
       You can get 'tidy' here: https://github.com/htacg/tidy-html5 -->
  <repository name="gstreamer"
              default="yes"
              href="http://gstreamer.freedesktop.org/src/"
              type="tarball" />
  <repository name="github.com"
              href="https://github.com/"
              type="tarball" />
  <repository name="ffmpeg"
              href="https://ffmpeg.org/releases/"
              type="tarball" />
  <repository name="pypi"
              href="https://files.pythonhosted.org/packages/source/"
              type="tarball" />

  <!-- Shared definitions for the bundled codec and support libraries below. -->
  <include href="../xpra-codecs.modules" />
  <include href="../xpra-tools.modules" />

  <meson id="liborc"
         mesonargs="-Dbenchmarks=disabled -Dexamples=disabled -Dtests=disabled">
    <branch module="orc/orc-0.4.44.tar.xz"
            version="0.4.44"
            hash="sha256:4aeb97aea2b58224029dc2b23d7d064cfa990cb4fb8c4da440bcbe9c95bc5d2d" />
  </meson>
  <cmake id="faad2">
    <branch module="knik0/faad2/archive/refs/tags/2.11.4.tar.gz"
            version="2.11.4"
            checkoutdir="faad-2.11.4"
            hash="sha256:ee479ccbae4a8387ab696e6f21a481bd83fe3881471cafa81b4ae59d7d3aed43"
            repo="github.com" />
  </cmake>
  <autotools id="ffmpeg"
             autogen-sh="configure"
             autogen-template="%(srcdir)s/%(autogen-sh)s --prefix=%(prefix)s %(autogenargs)s"
             autogenargs="--enable-gpl --enable-version3 --enable-shared --disable-static --disable-runtime-cpudetect --disable-programs --disable-ffplay --disable-ffprobe --disable-doc">
    <branch module="ffmpeg-9.0.2.tar.xz"
            version="9.0.2"
            hash="sha256:8c3850283eb25fa026482078a04051e0be17347b09ef81a0849bec15a96e002e"
            repo="ffmpeg" />
    <dependencies>
      <dep package="nasm" />
    </dependencies>
  </autotools>
  <meson id="gstreamer">
    <branch module="gstreamer/gstreamer-1.28.8.tar.xz"
            version="1.28.8"
            hash="sha256:baa8e86985ad6417cc0ad6e7b79ff2884c6779c8b1c7a6240e7121822c86e524">
    </branch>
    <after>
      <dep package="glib" />
    </after>
  </meson>
  <meson id="gst-plugins-base"
         mesonargs="-Dexamples=disabled -Ddoc=disabled">
    <branch module="gst-plugins-base/gst-plugins-base-1.28.8.tar.xz"
            version="1.28.8"
            hash="sha256:ade70e3381fcbb024f1f20aa9ede9b5654aeed39d5bd70b1a98f53015e501117" />
    <dependencies>
      <dep package="gstreamer" />
      <dep package="liborc" />
      <dep package="libogg" />
      <dep package="libvorbis" />
      <dep package="opus" />
      <dep package="pango" />
      <dep package="graphene" />
      <dep package="libpng" />
      <dep package="libjpeg" />
      <dep package="zlib" />
    </dependencies>
  </meson>
  <meson id="gst-plugins-good">
    <branch module="gst-plugins-good/gst-plugins-good-1.28.8.tar.xz"
            version="1.28.8"
            hash="sha256:a7670ed900d3d03be744d25c1873b239896e9a82ce6d17f8febc6fffbaee9521">
    </branch>
    <dependencies>
      <dep package="gstreamer" />
      <dep package="gst-plugins-base" />
      <dep package="libxml2" />
      <dep package="flac" />
      <dep package="speex" />
      <dep package="twolame" />
      <dep package="libvpx" />
      <dep package="libpng" />
      <dep package="libjpeg" />
      <dep package="cairo" />
      <dep package="gdk-pixbuf" />
      <dep package="gtk+-3.0" />
      <dep package="zlib" />
      <dep package="libsoup" />
      <dep package="libsoup3" />
      <dep package="libnettle" />
      <dep package="libgcrypt" />
      <dep package="openssl" />
    </dependencies>
  </meson>
  <meson id="gst-plugins-ugly"
         mesonargs="-Dgpl=enabled -Dx264=enabled">
    <branch module="gst-plugins-ugly/gst-plugins-ugly-1.28.8.tar.xz"
            version="1.28.8"
            hash="sha256:51ae53002e3bbe9ed0f2215020c5a248bf0ed41b9d9a2a4e102b8583fedab61c" />
    <dependencies>
      <dep package="gstreamer" />
      <dep package="gst-plugins-base" />
      <dep package="x264" />
    </dependencies>
  </meson>
  <meson id="gst-plugins-bad">
    <branch module="gst-plugins-bad/gst-plugins-bad-1.28.8.tar.xz"
            version="1.28.8"
            hash="sha256:670d888bde8242579b0d8e91f60cf337aa7be20ca7c315ebfbdd6e5a9218d104">
      <patch file="gst-plugins-bad-missing-enum.patch"
             strip="1" />
    </branch>
    <dependencies>
      <dep package="gstreamer" />
      <dep package="gst-plugins-base" />
      <dep package="faad2" />
      <dep package="openssl" />
      <dep package="libxml2" />
      <dep package="faac" />
      <dep package="libaom" />
      <dep package="libde265" />
      <dep package="openh264" />
      <dep package="opus" />
      <dep package="libwebp" />
      <dep package="librsvg" />
      <dep package="libqrencode" />
      <dep package="cairo" />
      <dep package="pango" />
      <dep package="curl" />
      <dep package="libnettle" />
      <dep package="libgcrypt" />
    </dependencies>
  </meson>
  <meson id="gst-libav">
    <branch module="gst-libav/gst-libav-1.28.8.tar.xz"
            version="1.28.8"
            hash="sha256:98ad3d7f8932c495e268708903f1c3388d5f26a0db34727a9f861ee23b724177">
    </branch>
    <dependencies>
      <dep package="gstreamer" />
      <dep package="gst-plugins-base" />
      <dep package="ffmpeg" />
    </dependencies>
  </meson>

  <pip id="python3-typing-extensions" python3="1">
    <branch module="t/typing_extensions/typing_extensions-4.16.0.tar.gz"
            hash="sha256:dc983d19a509c94dba722ee6abd33940f7c05a89e243c47e907eb4db6f1a43e5"
            version="4.16.0"
            repo="pypi" />
    <dependencies>
      <dep package="python3" />
    </dependencies>
    <after>
      <dep package="python3" />
    </after>
  </pip>

  <meson id="gst-python">
    <branch module="gst-python/gst-python-1.28.8.tar.xz"
            version="1.28.8"
            hash="sha256:6e0d8dd920234b9feeb86003d8f43c1996491f9d8190882329bf56f60a70206e">
    </branch>
    <dependencies>
      <dep package="gstreamer" />
      <dep package="gst-plugins-base" />
      <dep package="pygobject3" />
      <dep package="python3-typing-extensions" />
    </dependencies>
  </meson>
  <metamodule id="meta-gtk-osx-gstreamer">
    <dependencies>
      <dep package="gstreamer" />
      <dep package="gst-plugins-base" />
      <dep package="gst-plugins-good" />
      <dep package="gst-plugins-ugly" />
      <dep package="gst-plugins-bad" />
      <dep package="gst-libav" />
      <dep package="gst-python" />
    </dependencies>
  </metamodule>
</moduleset>
