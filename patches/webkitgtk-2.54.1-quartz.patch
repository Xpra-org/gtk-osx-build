Preserve the GTK/Quartz bundle integration on WebKitGTK 2.54.1.

Use dyld for the executable path, find relocated helpers and the injected
bundle, and keep the WebProcess out of the Dock. The old ICU, socket,
audit-token and C++ fixes are already implemented upstream or their old
code paths have been replaced. This recipe disables GStreamer, so its old
GStreamer-specific fixes are no longer needed.

--- a/Source/WTF/wtf/glib/FileSystemGlib.cpp
+++ b/Source/WTF/wtf/glib/FileSystemGlib.cpp
@@ -27,6 +27,10 @@
 #include <wtf/text/CString.h>
 #include <wtf/text/MakeString.h>
 #include <wtf/text/WTFString.h>
+
+#if OS(DARWIN)
+#include <mach-o/dyld.h>
+#endif

 #if !OS(WINDOWS)
 #include <limits.h>
@@ -68,6 +72,16 @@
     if (result <= 0)
         return { };
     return CString(unsafeMakeSpan(readLinkBuffer.data(), static_cast<size_t>(result)));
+}
+#elif OS(DARWIN)
+CString currentExecutablePath()
+{
+    uint32_t size = 0;
+    _NSGetExecutablePath(nullptr, &size);
+    GUniquePtr<char> path(g_new(char, size));
+    if (_NSGetExecutablePath(path.get(), &size))
+        return { };
+    return path.get();
 }
 #elif OS(HURD)
 CString currentExecutablePath()
