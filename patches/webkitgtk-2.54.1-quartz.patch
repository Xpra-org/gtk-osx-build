 #endif

 #if ENABLE(2022_GLIB_API)
@@ -345,6 +350,19 @@
     const char* bundleDirectory = g_getenv("WEBKIT_INJECTED_BUNDLE_PATH");
     if (bundleDirectory && g_file_test(bundleDirectory, G_FILE_TEST_IS_DIR))
         return bundleDirectory;
+
+#if PLATFORM(GTK) && OS(DARWIN)
+    // Find the injected bundle beside the loaded library after relocation.
+    static GUniquePtr<char> relocatedBundlePath([]() -> char* {
+        Dl_info libraryInfo;
+        if (!dladdr(reinterpret_cast<const void*>(injectedBundleDirectory), &libraryInfo) || !libraryInfo.dli_fname)
+            return nullptr;
+        GUniquePtr<char> libraryDirectory(g_path_get_dirname(libraryInfo.dli_fname));
+        return g_build_filename(libraryDirectory.get(), "webkit" WEBKITGTK_API_INFIX "gtk-" WEBKITGTK_API_VERSION, "injected-bundle", nullptr);
+    }());
+    if (relocatedBundlePath && g_file_test(relocatedBundlePath.get(), G_FILE_TEST_IS_DIR))
+        return relocatedBundlePath.get();
+#endif

     static const char* injectedBundlePath = PKGLIBDIR G_DIR_SEPARATOR_S "injected-bundle" G_DIR_SEPARATOR_S;
     return injectedBundlePath;
